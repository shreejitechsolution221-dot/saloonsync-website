# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://saloonsync.vasudev-ai.in

# ── Auth links (optional — leave blank if not yet connected) ───────────────────
NEXT_PUBLIC_LOGIN_URL=
NEXT_PUBLIC_REGISTER_URL=

# ── Resend (email) ─────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The address emails are sent FROM.
# Must be a verified domain in your Resend account.
# Example: Saloonsync <noreply@yourdomain.com>
RESEND_FROM_EMAIL=Saloonsync <noreply@saloonsync.vasudev-ai.in>

# The inbox that receives admin notifications and is the reply-to for auto-replies.
# Defaults to help@saloonsync.vasudevai.in if not set.
ADMIN_EMAIL=preet.gajjar@vasudev-ai.in
